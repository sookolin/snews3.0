# ─── General ───────────────────────────────────────────────────────────────
APP_NAME=CityNews
APP_ENV=development            # development | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-please-32chars-min
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_LANGUAGE=ru
SUPPORTED_LANGUAGES=ru,en

# ─── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=citynews
POSTGRES_PASSWORD=citynews_password
POSTGRES_DB=citynews

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ─── Celery ────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── JWT / auth ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# ─── First super admin (created by scripts/seed) ─────────────────────────────
FIRST_SUPERADMIN_EMAIL=admin@example.com
FIRST_SUPERADMIN_PASSWORD=ChangeMe123!

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=0000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_MODERATION_GROUP_ID=-1000000000000   # supergroup with topics enabled
TELEGRAM_WEBHOOK_URL=                          # empty = long polling
ADMIN_PANEL_URL=http://localhost:3000

# ─── AI providers ─────────────────────────────────────────────────────────────
DEFAULT_AI_PROVIDER=anthropic                  # anthropic | openai | gemini | local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LOCAL_LLM_BASE_URL=http://localhost:11434/v1   # ollama-compatible endpoint
LOCAL_LLM_MODEL=llama3.1

# ─── Media / storage ──────────────────────────────────────────────────────────
MEDIA_ROOT=/data/media
MAX_UPLOAD_SIZE_MB=50
FFMPEG_BINARY=ffmpeg

# ─── Backups ──────────────────────────────────────────────────────────────────
BACKUP_ROOT=/data/backups
BACKUP_CRON_HOUR=3

# --- Yandex Maps (frontend geo picker) ----------------------------------------
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# --- OAuth / social login (frontend build-time, must be NEXT_PUBLIC_*) --------
# Telegram Login Widget: bot username WITHOUT @ (BotFather -> /setdomain required)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Yandex OAuth app client id (oauth.yandex.ru/client/new, implicit flow)
NEXT_PUBLIC_YANDEX_CLIENT_ID=
# VK app id (id.vk.com / dev.vk.com -> app settings)
NEXT_PUBLIC_VK_CLIENT_ID=
